{
  "openapi": "3.1.0",
  "info": {
    "title": "Naija Tickets API — Phase 2",
    "version": "1.1.0",
    "description": "Server-to-server credential introspection and assigned published event/ticket/availability reads. Live resources only; test resource calls fail closed with SANDBOX_NOT_CONFIGURED until an isolated sandbox is provisioned. No checkout, order reads, widget or outgoing webhooks."
  },
  "servers": [
    {
      "url": "https://naija-tickets.vercel.app",
      "description": "Requires deploying Phase 2 source and applying migrations to the target project."
    }
  ],
  "paths": {
    "/api/v1/integration": {
      "get": {
        "operationId": "getIntegrationIdentity",
        "summary": "Inspect the authenticated integration",
        "security": [
          {
            "IntegrationSecret": []
          }
        ],
        "responses": {
          "200": {
            "description": "Integration identity and currently supported capabilities; no secret material.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data", "meta"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "name",
                        "organiser_id",
                        "environment",
                        "scopes",
                        "key_id",
                        "expires_at",
                        "capabilities"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "name": {
                          "type": "string"
                        },
                        "organiser_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "environment": {
                          "type": "string",
                          "enum": ["test", "live"]
                        },
                        "scopes": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "integration:read",
                              "events:read",
                              "tickets:read",
                              "availability:read"
                            ]
                          }
                        },
                        "key_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "capabilities": {
                          "type": "object",
                          "required": [
                            "introspection",
                            "event_api",
                            "hosted_checkout",
                            "widget",
                            "sandbox_purchases"
                          ],
                          "properties": {
                            "introspection": {
                              "type": "boolean",
                              "const": true
                            },
                            "event_api": {
                              "type": "boolean",
                              "description": "True for live keys; false for test keys without an isolated sandbox. Individual routes still require their own scopes."
                            },
                            "hosted_checkout": {
                              "type": "boolean",
                              "const": false
                            },
                            "widget": {
                              "type": "boolean",
                              "const": false
                            },
                            "sandbox_purchases": {
                              "type": "boolean",
                              "const": false
                            }
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": ["request_id"],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid, missing, expired, revoked or disabled key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing integration:read scope or browser Origin provided.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate budget exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Seconds until the current rate window resets."
              }
            }
          },
          "503": {
            "description": "Authentication or limiter dependency unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List assigned, published events that have not ended",
        "description": "Requires events:read. Event grants, ownership, active credential, issuer management permission and live mode are rechecked in the database. No CORS/browser secret-key use. Unknown/repeated query parameters are rejected.",
        "security": [
          {
            "IntegrationSecret": []
          }
        ],
        "x-required-scope": "events:read",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Number of records returned."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024
            },
            "description": "Opaque next_cursor from this same application, mode, resource and filters. Keep filters unchanged; limit may change."
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": "Exact city name, case insensitive."
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "description": "Exact category slug, such as concert."
          },
          {
            "name": "starts_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive event start lower bound. ISO timezone required; at most three fractional second digits."
          },
          {
            "name": "starts_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusive event start upper bound. ISO timezone required; at most three fractional second digits."
          }
        ],
        "responses": {
          "200": {
            "description": "Read-only response. Private, no-store; event changes can affect later pages.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["data", "meta"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "maxItems": 100
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["request_id", "next_cursor"],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "next_cursor": {
                          "type": ["string", "null"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or page cursor.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Present for HTTP 429."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, revoked, expired, disabled or wrong-mode key.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Present for HTTP 429."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope or browser Origin not permitted.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Present for HTTP 429."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "405": {
            "description": "GET only; Allow: GET.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Present for HTTP 429."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "429": {
            "description": "Shared request budget exceeded; Retry-After seconds.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Present for HTTP 429."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            }
          },
          "503": {
            "description": "SANDBOX_NOT_CONFIGURED for test resources; otherwise dependency outage, excessive catalogue size or invalid unsafe numeric data.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
