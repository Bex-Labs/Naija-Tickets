{
  "openapi": "3.1.0",
  "info": {
    "title": "Naija Tickets Phase 5 ticket widgets",
    "version": "2026-10-16",
    "description": "Additive widget and organiser-management contract. Public widget IDs are not API credentials. See integrations-phase5.md; existing Phase 3 private checkout/API and Phase 4 webhook contracts remain in force."
  },
  "paths": {
    "/embed/events/{eventId}": {
      "get": {
        "summary": "Render a public iframe for an assigned published event",
        "security": [],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "widget",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^nt_widget_[a-f0-9]{32}$"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "test",
                "live"
              ]
            }
          },
          {
            "name": "parent_origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Standalone no-store event/ticket HTML with exact frame-ancestors and optional signed checkout form.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, environment, origin or return path."
          },
          "403": {
            "description": "Wrong origin or current permission denied."
          },
          "404": {
            "description": "Widget/application/event unavailable."
          },
          "405": {
            "description": "Method not allowed."
          },
          "409": {
            "description": "Configuration, inventory or idempotency conflict."
          },
          "429": {
            "description": "Shared rate limit exceeded; Retry-After header."
          },
          "503": {
            "description": "Feature, resource binding, limiter or hosted configuration unavailable."
          }
        }
      }
    },
    "/api/integrations/widgets/{widgetId}/events/{eventId}": {
      "get": {
        "summary": "Read public widget configuration without secret credentials",
        "security": [],
        "parameters": [
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^nt_widget_[a-f0-9]{32}$"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "test",
                "live"
              ]
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact registered website origin in the selected environment. No Authorization header is accepted."
          }
        ],
        "responses": {
          "200": {
            "description": "Exact-origin CORS; no credentials or checkout proof/private capability. Quantities/prices are advisory.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WidgetSnapshot"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, environment, origin or return path.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          },
          "403": {
            "description": "Wrong origin or current permission denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          },
          "404": {
            "description": "Widget/application/event unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          },
          "409": {
            "description": "Configuration, inventory or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          },
          "503": {
            "description": "Feature, resource binding, limiter or hosted configuration unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicError"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "Validate a GET-only, header-free CORS preflight",
        "security": [],
        "parameters": [
          {
            "name": "widgetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^nt_widget_[a-f0-9]{32}$"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "test",
                "live"
              ]
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact registered website origin in the selected environment. No Authorization header is accepted."
          },
          {
            "name": "Access-Control-Request-Method",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "GET"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Exact-origin Access-Control-Allow-Origin; Allow-Methods GET; max-age 60. No custom request headers or credentials permitted."
          },
          "400": {
            "description": "Invalid fields, environment, origin or return path."
          },
          "403": {
            "description": "Wrong origin or current permission denied."
          },
          "404": {
            "description": "Widget/application/event unavailable."
          },
          "405": {
            "description": "Method not allowed."
          },
          "409": {
            "description": "Configuration, inventory or idempotency conflict."
          },
          "429": {
            "description": "Shared rate limit exceeded; Retry-After header."
          },
          "503": {
            "description": "Feature, resource binding, limiter or hosted configuration unavailable."
          }
        }
      }
    },
    "/integrations/widget-checkout": {
      "post": {
        "summary": "Submit a native user-activated form and navigate to existing hosted checkout",
        "description": "Not a cross-origin JSON API. Requires Naija frame Origin, no Authorization and, when present, Sec-Fetch-Dest=document. Five-minute signed proof; no prices, customer IDs or attendee details. Duplicate proof/intent replays the existing session. Max 16 KiB/five seconds, 20 selected tiers, 20 packages/tier and 400 admissions.",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Trusted Naija deployment origin, not the embedding partner origin."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "proof"
                ],
                "properties": {
                  "proof": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "promo_code": {
                    "type": "string",
                    "maxLength": 32
                  }
                },
                "patternProperties": {
                  "^quantity_[a-f0-9-]{36}$": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]?)$"
                  }
                },
                "additionalProperties": false,
                "maxProperties": 102
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Private/no-store redirect to existing signed hosted URL. Middleware exchanges access into a first-party HttpOnly cookie and cleans the URL. Never publish/log the Location capability.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, environment, origin or return path.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Wrong origin or current permission denied.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Widget/application/event unavailable.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Configuration, inventory or idempotency conflict.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded; Retry-After header.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Feature, resource binding, limiter or hosted configuration unavailable.",
            "headers": {
              "X-Request-ID": {
                "description": "Safe request identifier.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "private, no-store",
                "schema": {
