                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "415": {
            "description": "Use application/x-www-form-urlencoded.",
            "headers": {
              "X-Request-ID": {
