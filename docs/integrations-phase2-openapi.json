  "components": {
    "securitySchemes": {
      "IntegrationSecret": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "nt_test_<id>_<secret> or nt_live_<id>_<secret>",
        "description": "Requires integration:read. Credentials are secret server keys, not widget identifiers."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "slug",
          "description",
          "image_url",
          "venue",
          "starts_at",
          "ends_at",
          "timezone",
          "sales_start_at",
          "sales_end_at",
          "organiser",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": ["string", "null"]
          },
          "venue": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address", "city", "state"],
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            }
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string"
          },
          "sales_start_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "sales_end_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "organiser": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "verified"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            }
          },
          "category": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "slug"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          }
        }
      },
      "TicketType": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_id",
          "name",
          "description",
          "currency",
          "price_kobo",
          "standard_price_kobo",
          "price_kind",
          "early_bird_price_kobo",
          "early_bird_ends_at",
          "admissions_per_ticket",
          "min_packages_per_order",
          "max_packages_per_order",
          "sales_start_at",
          "sales_end_at",
          "sale_status",
          "fees_included",
          "promo_discount_included"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "currency": {
            "const": "NGN",
            "type": "string"
          },
          "price_kobo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "standard_price_kobo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "price_kind": {
            "type": "string",
            "enum": ["standard", "early_bird"]
          },
          "early_bird_price_kobo": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "early_bird_ends_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
