# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Resend server key and a sender on a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=
# Optional public ticket-link origin when APP_URL is localhost
EMAIL_APP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
# Exact public app origin in production, for example https://tickets.example.com
APP_URL=http://localhost:3000

# Server-only administrator access
ADMIN_USERNAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Phase 4 outgoing webhooks (server-only; disabled until sandbox acceptance)
INTEGRATIONS_WEBHOOKS_ENABLED=false
# Dedicated random secret, at least 43 characters. Vercel Cron sends it as Bearer.
CRON_SECRET=
# Dedicated AES-256 keys: JSON object with up to three versions. Each value is
# exactly 32 random bytes encoded as 43 base64url characters. Never reuse keys.
INTEGRATIONS_WEBHOOK_ENCRYPTION_VERSION=v1
INTEGRATIONS_WEBHOOK_ENCRYPTION_KEYS={}

# Phase 5 public widgets; also opt in per application and environment.
INTEGRATIONS_WIDGETS_ENABLED=false

# Phase 6 application-attributed operations; opt-in scopes are also required.
INTEGRATIONS_ADVANCED_ENABLED=false
# Additional opt-in for verification/check-in using the key creator's authority.
INTEGRATIONS_ENTRY_ENABLED=false

# Hosted checkout/resource binding (server only; disabled until isolated acceptance)
INTEGRATIONS_RESOURCE_MODE=live
INTEGRATIONS_CHECKOUT_ENABLED=false
INTEGRATIONS_SIGNING_KEY_VERSION=v1
INTEGRATIONS_SIGNING_SECRET=
INTEGRATIONS_PREVIOUS_SIGNING_KEYS={}
# Distinct project references are required for test mode; never bind test to live.
INTEGRATIONS_SANDBOX_PROJECT_REF=
INTEGRATIONS_LIVE_PROJECT_REF=

# Checkout modal, exact registered return origin only; disabled until acceptance.
INTEGRATIONS_POPUP_ENABLED=false
