            "type": "integer",
            "minimum": 1
          },
          "min_packages_per_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_packages_per_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sales_start_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "sales_end_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "sale_status": {
            "type": "string",
            "enum": [
              "open",
              "upcoming",
              "closed",
              "sold_out",
              "allocation_limited"
            ]
          },
          "fees_included": {
            "const": false,
            "type": "boolean"
          },
          "promo_discount_included": {
            "const": false,
            "type": "boolean"
          }
        }
      },
      "TicketAvailability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticket_type_id",
          "admissions_per_ticket",
          "total_admissions",
          "sold_admissions",
          "reserved_admissions",
          "remaining_admissions",
          "remaining_packages",
          "early_bird_remaining_packages",
          "max_packages_at_current_price",
          "sale_status"
        ],
        "properties": {
          "ticket_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "admissions_per_ticket": {
            "type": "integer",
            "minimum": 1
          },
          "total_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sold_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reserved_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remaining_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remaining_packages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "early_bird_remaining_packages": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "max_packages_at_current_price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sale_status": {
            "type": "string",
            "enum": [
              "open",
              "upcoming",
              "closed",
              "sold_out",
              "allocation_limited"
            ]
          }
        }
      },
      "Availability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "as_of",
          "advisory",
          "total_admissions",
          "sold_admissions",
          "reserved_admissions",
          "remaining_admissions",
          "ticket_types"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "advisory": {
            "const": true,
            "type": "boolean"
          },
          "total_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sold_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reserved_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remaining_admissions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ticket_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketAvailability"
            },
            "maxItems": 100
          }
        }
      },
      "ReadError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
