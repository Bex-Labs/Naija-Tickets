    "/api/organiser/integrations/{id}/widget": {
      "get": {
        "summary": "Read per-environment widget settings; disabled defaults do not create a row",
        "security": [
          {
            "OrganiserJWT": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "test",
                "live"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normal private management envelope. Canonical widgetOrigin is server-derived.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WidgetSettings"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "request_id"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Confirmed organiser sign-in required."
          },
          "400": {
            "description": "Invalid fields, environment, origin or return path."
          },
          "403": {
            "description": "Wrong origin or current permission denied."
          },
          "404": {
            "description": "Widget/application/event unavailable."
          },
          "405": {
            "description": "Method not allowed."
          },
          "409": {
            "description": "Configuration, inventory or idempotency conflict."
          },
          "429": {
            "description": "Shared rate limit exceeded; Retry-After header."
          },
          "503": {
            "description": "Feature, resource binding, limiter or hosted configuration unavailable."
          }
        }
      },
      "patch": {
        "summary": "Opt widget/checkout permission in or out; increments configuration revision",
        "description": "Confirmed organiser JWT and explicit integration-manager grant required. Current resource mode must match. Saving invalidates old unpaid widget actions; already-authorised payment completion and paid receipt access remain safe.",
        "security": [
          {
            "OrganiserJWT": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WidgetUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated settings in normal data/meta management envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WidgetSettings"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "request_id"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Confirmed organiser sign-in required."
          },
          "400": {
            "description": "Invalid fields, environment, origin or return path."
          },
          "403": {
            "description": "Wrong origin or current permission denied."
          },
          "404": {
            "description": "Widget/application/event unavailable."
          },
          "405": {
            "description": "Method not allowed."
          },
          "409": {
            "description": "Configuration, inventory or idempotency conflict."
          },
          "429": {
            "description": "Shared rate limit exceeded; Retry-After header."
          },
          "503": {
            "description": "Feature, resource binding, limiter or hosted configuration unavailable."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OrganiserJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase user JWT"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "slug",
          "description",
          "image_url",
          "venue",
          "starts_at",
          "ends_at",
          "timezone",
          "sales_start_at",
          "sales_end_at",
          "organiser",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "address",
              "city",
              "state"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            }
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string"
          },
          "sales_start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sales_end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "organiser": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "verified"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            }
          },
          "category": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "slug"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          }
        }
      },
      "WidgetTicketType": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_id",
          "name",
          "description",
          "currency",
          "price_kobo",
          "standard_price_kobo",
          "price_kind",
          "early_bird_price_kobo",
          "early_bird_ends_at",
          "admissions_per_ticket",
          "min_packages_per_order",
          "max_packages_per_order",
          "sales_start_at",
          "sales_end_at",
          "sale_status",
          "fees_included",
          "promo_discount_included",
          "max_packages_available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "const": "NGN",
            "type": "string"
          },
          "price_kobo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "standard_price_kobo": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "price_kind": {
            "type": "string",
            "enum": [
              "standard",
              "early_bird"
            ]
          },
          "early_bird_price_kobo": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "early_bird_ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
